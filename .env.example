# IAOS local configuration template. Never put real credentials in this file.

# Durable B2 governance state. Use a path outside the repository.
IAOS_TOOL_STATE_DB=D:/iaos-run-state/iaos-tools.sqlite

# Effects are fail-closed when unset. Set explicitly only for a controlled run.
# IAOS_B2_ENABLE_EFFECTS=1

# Optional OpenBot computer runtime connection for IAOS adapters.
# IAOS_COMPUTER_URL=http://127.0.0.1:55248
# IAOS_COMPUTER_BOT_ID=
# IAOS_COMPUTER_TOKEN=
# IAOS_COMPUTER_RUNTIME_PORT=8767

# Optional Google integration configuration. Keep the client secret outside the repo.
# IAOS_GOOGLE_CLIENT_SECRET_FILE=D:/iaos-run-secrets/google-client-secret.json
# IAOS_GOOGLE_REDIRECT_URI=http://127.0.0.1:8766/integrations/google/callback
# IAOS_GOOGLE_UI_ORIGIN=http://127.0.0.1:5173

# Legacy IAOS live-harness compatibility only; model configuration for the
# Architecture 2 product belongs to OpenDots (see its .env.example).
# AGNES_API_KEY=
# AGNES_ENDPOINT=https://apihub.agnes-ai.com/v1/chat/completions
# AGNES_MODEL=agnes-2.5-flash
# BRAVE_SEARCH_API_KEY=

# OpenDots agent host
OPENDOTS_BASE_URL=http://127.0.0.1:4310

# OpenBot / computer runtime as consumed by the OpenDots host
COMPUTER_SUPERVISOR_URL=http://127.0.0.1:55248
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
COMPUTER_NAMESPACE=opendots

# Optional explicit mediation endpoint for the OpenDots computer adapter.
IAOS_TOOL_GATEWAY_URL=http://127.0.0.1:8791
